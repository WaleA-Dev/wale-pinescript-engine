//@version=6
strategy("Starter NDX Trader v1", overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.fixed,
     default_qty_value=5,
     commission_type=strategy.commission.percent,
     commission_value=0.05,
     pyramiding=0,
     process_orders_on_close=true)

// --------------------
// Inputs
// --------------------
fastLen = input.int(20, "Fast EMA", minval=5, maxval=200)
slowLen = input.int(50, "Slow EMA", minval=10, maxval=400)
rsiLen  = input.int(14, "RSI Length", minval=2, maxval=50)
rsiPull = input.int(45, "RSI pullback trigger", minval=10, maxval=60)
rsiMax  = input.int(70, "RSI overbought filter", minval=55, maxval=95)
atrLen  = input.int(14, "ATR Length", minval=2, maxval=100)
slATR   = input.float(1.8, "Stop (ATR multiple)", minval=0.5, maxval=10.0, step=0.1)
tpATR   = input.float(2.8, "Target (ATR multiple)", minval=0.5, maxval=15.0, step=0.1)

// --------------------
// Indicators
// --------------------
emaFast = ta.ema(close, fastLen)
emaSlow = ta.ema(close, slowLen)
rsiVal  = ta.rsi(close, rsiLen)
atrVal  = ta.atr(atrLen)

// Trend-pullback entry (long only): in an uptrend, buy when RSI recovers
// back above the pullback level but is not yet overbought.
trendUp    = emaFast > emaSlow
longSignal = trendUp and ta.crossover(rsiVal, rsiPull) and rsiVal < rsiMax

if (longSignal and strategy.position_size <= 0)
    strategy.entry("L", strategy.long)

// --------------------
// Dynamic ATR bracket exit (recomputed every bar from the fill price)
// --------------------
longStop  = strategy.position_avg_price - slATR * atrVal
longLimit = strategy.position_avg_price + tpATR * atrVal
strategy.exit("XL", from_entry="L", stop=longStop, limit=longLimit)

// --------------------
// Plots
// --------------------
plot(emaFast, "EMA Fast")
plot(emaSlow, "EMA Slow")
