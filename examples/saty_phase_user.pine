//@version=6
strategy("Saty Phase Strategy", overlay=true, initial_capital=100000)

// === USER INPUTS ===
show_label          = input(true,  "Show Label")
show_zone_crosses   = input(true,  "Show Zone Crosses")
show_extreme_crosses= input(true,  "Show Extreme Crosses")

// === COLORS ===
green       = color.rgb(0,255,0)
red         = color.rgb(255,0,0)
magenta     = color.rgb(255,0,255)
light_gray  = color.rgb(200,200,200)
gray        = color.rgb(150,150,150)
dark_gray   = color.rgb(100,100,100)
yellow      = color.rgb(255,255,0)

// === PIVOT (for reference) ===
pivot       = ta.ema(close, 21)
above_pivot = close >= pivot

// === PHASE ZONES (Horizontal lines) ===
plot(100.0,  color=light_gray, linewidth=1, display=display.all - display.price_scale)
plot(61.8,   color=gray,       linewidth=1, display=display.all - display.price_scale)
plot(23.6,   color=dark_gray,  linewidth=1, display=display.all - display.price_scale)
plot(-23.6,  color=dark_gray,  linewidth=1, display=display.all - display.price_scale)
plot(-61.8,  color=gray,       linewidth=1, display=display.all - display.price_scale)
plot(-100.0, color=light_gray, linewidth=1, display=display.all - display.price_scale)

// === BOLLINGER/COMPRESSION LOGIC (unchanged) ===
bband_offset            = 2.0 * ta.stdev(close, 21)
bband_up                = pivot + bband_offset
bband_down              = pivot - bband_offset
compression_threshold_up   = pivot + (2.0 * ta.atr(14))
compression_threshold_down = pivot - (2.0 * ta.atr(14))
expansion_threshold_up     = pivot + (1.854 * ta.atr(14))
expansion_threshold_down   = pivot - (1.854 * ta.atr(14))
compression = above_pivot ? (bband_up - compression_threshold_up) : (compression_threshold_down - bband_down)
in_expansion_zone = above_pivot ? (bband_up - expansion_threshold_up) : (expansion_threshold_down - bband_down)
expansion = compression[1] <= compression[0]

var compression_tracker = false
if expansion and in_expansion_zone > 0
    compression_tracker := false
else if compression <= 0
    compression_tracker := true
else
    compression_tracker := false

plot(0, color=(compression_tracker ? magenta : dark_gray), linewidth=2, display=display.all - display.price_scale)

// === COMPRESSION TABLE LABEL ===
var tbl = table.new(position.top_right, 1, 1)
if barstate.islast and show_label
    table.cell(tbl, 0, 0, 'Compression', bgcolor=magenta)
if compression_tracker == false and show_label
    table.clear(tbl, 0, 0, 0, 0)

// === SATY PHASE OSCILLATOR (same formula) ===
raw_signal       = ((close - pivot) / (3.0 * ta.atr(14))) * 100
oscillator       = ta.ema(raw_signal, 3)
plot(oscillator, title="Phase Oscillator", linewidth=2, color=(compression_tracker ? magenta : (oscillator >= 0.0 ? green : red)))

// === "LEAVING" SIGNALS (for visual) ===
leaving_accumulation = oscillator[1] <= -61.8 and oscillator > -61.8
leaving_extreme_down = oscillator[1] <= -100  and oscillator > -100
// (Commented out distribution exit @ +61.8 so we only sell at +100)
// leaving_distribution = oscillator[1] >= 61.8 and oscillator < 61.8
leaving_extreme_up   = oscillator[1] >= 100   and oscillator < 100

plot((show_zone_crosses and leaving_accumulation) ? oscillator[1] - 30 : na, title="Leaving Accumulation", style=plot.style_circles, color=yellow, linewidth=2, display=display.all - display.price_scale)
plot((show_extreme_crosses and leaving_extreme_down) ? oscillator[1] - 30 : na, title="Leaving Extreme Down", style=plot.style_circles, color=yellow, linewidth=2, display=display.all - display.price_scale)
// plot((show_zone_crosses and leaving_distribution) ? oscillator[1] + 30 : na, title="Leaving Distribution", style=plot.style_circles, color=yellow, linewidth=2, display=display.all - display.price_scale)
plot((show_extreme_crosses and leaving_extreme_up) ? oscillator[1] + 30 : na, title="Leaving Extreme Up", style=plot.style_circles, color=yellow, linewidth=2, display=display.all - display.price_scale)

// ──────────────────────────────────────────────────────────────────────────────
//                   >>>>>   STRATEGY LOGIC   <<<<<
// ──────────────────────────────────────────────────────────────────────────────

// 1) DEFINE ENTRY CONDITIONS: "Buy on oversold" (ex: leaving accumulation or extreme down)
bool buySignal = leaving_accumulation or leaving_extreme_down

// 2) DEFINE EXIT CONDITIONS: "Sell at peak overbought" OR "Bearish Divergence"

// 2A) Overbought exit => oscillator crossing down from >100
bool overboughtNow = oscillator[1] >= 100 and oscillator < 100

// 2B) Bearish divergence => Price makes higher high while oscillator does NOT
//    We'll do pivot detection on price + oscillator.
pivotLen = 3   // how many bars on each side to confirm local pivot
float pricePH = ta.pivothigh(high, pivotLen, pivotLen)
float oscPH   = ta.pivothigh(oscillator, pivotLen, pivotLen)

// We'll store last two pivot highs in var so we can compare them
var float lastPricePivotHigh = na
var float lastOscPivotHigh   = na

bool newPricePivot = not na(pricePH)
if newPricePivot
    // Shift old pivot forward
    lastPricePivotHigh := pricePH

bool newOscPivot = not na(oscPH)
if newOscPivot
    lastOscPivotHigh := oscPH

// Condition: "bearish divergence" =>
// price pivot is higher than old pivot, but oscillator pivot is lower
bool divergenceBearish = false
if newPricePivot and newOscPivot and not na(lastPricePivotHigh[1]) and not na(lastOscPivotHigh[1])
    // comparing *new* pivot vs the pivot from before it
    divergenceBearish := (pricePH > lastPricePivotHigh[1]) and (oscPH < lastOscPivotHigh[1])

// Final exit condition => Overbought or Bearish Divergence
bool exitSignal = overboughtNow or divergenceBearish

// ──────────────────────────────────────────────────────────────────────────────
// EXECUTE STRATEGY ENTRIES/EXITS
// ──────────────────────────────────────────────────────────────────────────────
if buySignal
    strategy.entry("Long", strategy.long)

if strategy.position_size > 0
    if exitSignal
        strategy.close("Long", comment="Peak Overbought or Bearish Div")
