//@version=6
strategy(
     "Smart Trend Momentum Strategy v6",
     overlay = true,
     initial_capital = 10000,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value = 100,
     commission_type = strategy.commission.percent,
     commission_value = 0.05
)

// === INPUTS ===
lenFast = input.int(20, "Fast EMA", minval=2, maxval=200)
lenSlow = input.int(
    50,
    "Slow EMA",
    minval=5,
    maxval=300,
    tooltip="Slow EMA length for the trend baseline"
)
rsiLen = input.int(14, "RSI Length", minval=2)
rsiMin = input.float(45.0, "RSI Min", minval=0, maxval=100)
rsiMax = input.float(70.0, "RSI Max", minval=0, maxval=100)
atrLen = input.int(14, "ATR Length", minval=1)
useShorts = input.bool(false, "Enable Shorts")

// === INDICATORS ===
emaFast = ta.ema(close, lenFast)
emaSlow = ta.ema(close, lenSlow)
rsiVal = ta.rsi(close, rsiLen)
atrVal = ta.atr(atrLen)

// === CONDITIONS ===
uptrend = emaFast > emaSlow
downtrend = emaFast < emaSlow
rsiOk = rsiVal > rsiMin and rsiVal < rsiMax
crossUp = ta.crossover(emaFast, emaSlow)
crossDown = ta.crossunder(emaFast, emaSlow)

longCondition = crossUp and rsiOk
shortCondition = crossDown and useShorts

// === ORDERS ===
if longCondition
    strategy.entry("Long", strategy.long)

if shortCondition
    strategy.entry("Short", strategy.short)

if downtrend
    strategy.close("Long", comment="Trend flip")

// === VISUALS ===
plot(emaFast, "Fast EMA", color=color.teal)
plot(emaSlow, "Slow EMA", color=color.orange)
