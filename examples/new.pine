//@version=6
strategy("Starter NDX Trader v1 (Frequent Trades, ATR Risk)", overlay=true,
     initial_capital=100000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=100,
     commission_type=strategy.commission.percent,
     commission_value=0.01,
     calc_on_order_fills=true,
     process_orders_on_close=true,
     use_bar_magnifier=true)


// --------------------
// Inputs
// --------------------
tfNote = "Run on 30m or 1H for more trades. Use NDX proxy like NAS100, QQQ, NQ1!, etc."


fastLen   = input.int(20, "Fast EMA", minval=5, maxval=200)
slowLen   = input.int(50, "Slow EMA", minval=10, maxval=400)
rsiLen    = input.int(14, "RSI Length", minval=2, maxval=50)
rsiPull   = input.int(45, "RSI Pullback Level (Long)", minval=10, maxval=60)
rsiPullS  = input.int(55, "RSI Pullback Level (Short)", minval=40, maxval=90)


atrLen    = input.int(14, "ATR Length", minval=2, maxval=100)
slATR     = input.float(2.0, "Stop (ATR multiple)", minval=0.5, maxval=10.0, step=0.25)
tpATR     = input.float(3.0, "Target (ATR multiple)", minval=0.5, maxval=15.0, step=0.25)


useTimeExit  = input.bool(true, "Enable time exit (prevents holds)")
maxHoldBars  = input.int(240, "Max hold bars", minval=10, maxval=5000,
                 tooltip="On 1H: 240 bars ~ 10 days")


// --------------------
// Core indicators
// --------------------
emaFast = ta.ema(close, fastLen)
emaSlow = ta.ema(close, slowLen)
rsiVal  = ta.rsi(close, rsiLen)
atrVal  = ta.atr(atrLen)


// Trend state
trendUp = emaFast > emaSlow
trendDn = emaFast < emaSlow


// Pullback entry logic:
// Long: trend up, RSI dips below pullback and then crosses back up
// Short: trend down, RSI rises above pullback and then crosses back down
longSignal  = trendUp and ta.crossover(rsiVal, rsiPull)
shortSignal = trendDn and ta.crossunder(rsiVal, rsiPullS)


// --------------------
// Orders
// --------------------
if (longSignal and strategy.position_size <= 0)
    strategy.entry("L", strategy.long)


if (shortSignal and strategy.position_size >= 0)
    strategy.entry("S", strategy.short)


// Protective exits via broker emulator
// Using strategy.exit() is the standard way to model stops/targets. :contentReference[oaicite:1]{index=1}
longStop  = strategy.position_avg_price - slATR * atrVal
longLimit = strategy.position_avg_price + tpATR * atrVal
shortStop = strategy.position_avg_price + slATR * atrVal
shortLimit= strategy.position_avg_price - tpATR * atrVal


strategy.exit("XL", from_entry="L", stop=longStop, limit=longLimit)
strategy.exit("XS", from_entry="S", stop=shortStop, limit=shortLimit)


// Optional time exit to avoid “stuck” holds
var int entryBar = na
newPos = (strategy.position_size != 0 and strategy.position_size[1] == 0)
flatNow = (strategy.position_size == 0 and strategy.position_size[1] != 0)


if newPos
    entryBar := bar_index
if flatNow
    entryBar := na


if useTimeExit and strategy.position_size != 0 and not na(entryBar)
    if (bar_index - entryBar) >= maxHoldBars
        if strategy.position_size > 0
            strategy.close("L", comment="TIME")
        if strategy.position_size < 0
            strategy.close("S", comment="TIME")


// --------------------
// Plots
// --------------------
plot(emaFast, "EMA Fast")
plot(emaSlow, "EMA Slow")

